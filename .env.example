# ==============================================================
# ENVIRONMENT VARIABLES FOR VERCEL DEPLOYMENT
# Poliklinik Umum (General Clinic) System
# ==============================================================

# 1. Supabase Cloud Sync & Realtime Antrean (Sangat Disarankan di Vercel)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Admin Gatekeeper URL Secret Key
# Kunci rahasia untuk mengakses portal admin: https://domain-anda.vercel.app/admin?key=sehat-utama-it-2026
ADMIN_SECRET_KEY=sehat-utama-it-2026

# 3. Kunci Enkripsi Backup Database (Opsional)
BACKUP_ENCRYPTION_KEY=sehat-utama-backup-secret-key-2026

# 4. Pengiriman Email Asli via Gmail SMTP (Nodemailer)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_SECURE=true
EMAIL_SERVER_USER=email-anda@gmail.com
EMAIL_SERVER_PASSWORD=your-16-char-app-password
EMAIL_FROM="Klinik Pratama Sehat Utama" <email-anda@gmail.com>

